# Public frontend config
NUXT_PUBLIC_CHECKOUT_API_BASE_URL=https://your-netlify-site.netlify.app
# Required for local dev so the Identity widget knows which site to authenticate against.
# Set to your main Netlify site URL (the one with Identity enabled).
# Branch deploys don't need this — Netlify sets the URL automatically.
NUXT_PUBLIC_NETLIFY_SITE_URL=https://your-netlify-site.netlify.app
# Admin pages are intended to be tested with `netlify dev`, which provides
# the Netlify functions + cookie flow locally at the same origin.

# Admin authentication (Netlify Identity)
ADMIN_EMAILS=admin@example.com,admin2@example.com
ADMIN_SESSION_SECRET=replace_with_long_random_secret

# Netlify function runtime config
SITE_URL=https://kelseyraineart.com
ALLOWED_ORIGINS=https://kelseyraineart.com,https://dev--krfa.netlify.app,http://localhost:8888,http://localhost:3000

# WHCC Editor API
WHCC_EDITOR_API_BASE_URL=https://prospector.dragdrop.design/api/v1
WHCC_KEY=replace_with_whcc_key
WHCC_SECRET=replace_with_whcc_secret
WHCC_ACCOUNT_ID=replace_with_whcc_account_id
WHCC_HTTP_TIMEOUT_MS=15000
